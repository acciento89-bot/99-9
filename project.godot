; Engine configuration file.
; 99.9% by Kamilunavo Games

config_version=5

[application]

config/name="99.9%"
config/description="One-tap precision game by Kamilunavo Games"
config/version="1.0.0"
config/icon="res://assets/icon.svg"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")

[autoload]

GodotIapPlugin="*res://addons/godot-iap/godot_iap.gd"

[admob]

general/android/enabled=true
general/android/app_id="ca-app-pub-3940256099942544~3347511713"
general/android/disable_initialization_optimization=false
general/android/disable_ad_loading_optimization=false
general/ios/enabled=true
general/ios/app_id="ca-app-pub-8944085355624754~5700066119"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=1
window/ios/hide_status_bar=true
window/ios/hide_home_indicator=true
window/ios/suppress_ui_gesture=true

[editor_plugins]

enabled=PackedStringArray("res://addons/godot-iap/plugin.cfg", "res://addons/admob/plugin.cfg")

[input_devices]

pointing/emulate_mouse_from_touch=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.018, 0.022, 0.035, 1)

[gui]

theme/default_font_multichannel_signed_distance_field=true
